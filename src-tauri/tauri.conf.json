{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iskra",
  "version": "1.0.0",
  "identifier": "pl.iskra.chat",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Iskra — asystent AI", "width": 1180, "height": 760, "minWidth": 320, "minHeight": 560, "resizable": true }], "security": { "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline';" } },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
